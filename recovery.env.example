# Main BTC paper cohort: retain simulated risk protection.
PAPER_STOP_LOSS_ENABLED=true
PAPER_TREND_STOP_LOSS_ENABLED=true
PAPER_TREND_STOP_SHADOW_MODE=false
PAPER_TAKE_PROFIT_ENABLED=true

# Keep real orders disabled. Do not set these to true for this recovery test.
REAL_ORDER_ADAPTER_INSTALLED=false
LIVE_APPROVAL_RECORDED=false

# Optional: values applied in BTCEntryPolicy when integrating btc_strategy_gate.py.
BTC_GATE_MIN_INTERNAL_SCORE=45
BTC_GATE_MAX_ENTRY_CENTS=75
BTC_GATE_MAX_SPREAD_CENTS=2
BTC_GATE_MAX_SIGNAL_AGE_SECONDS=90
BTC_GATE_MAX_TREND_SNAPSHOT_AGE_SECONDS=45
BTC_GATE_MIN_SECONDS_REMAINING=120
